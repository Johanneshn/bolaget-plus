{
  "name": "bolaget-plus",
  "description": "Bolaget+ is a browser extension that adds more features to Systembolaget's website.",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "author": "BroadcastDivers",
  "scripts": {
    "prepare": "simple-git-hooks && wxt prepare",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "ft": "prettier --write \"{src,e2e}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.config.ts\"",
    "ft:check": "prettier --check \"{src,e2e}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.config.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm build:chrome && playwright test",
    "test:interactive": "playwright test --ui",
    "test:matching": "playwright test --project=matching",
    "test:smoke": "pnpm build:chrome && playwright test --project=smoke --project=live-api",
    "test:live": "playwright test --project=live-api",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/chrome": "^0.0.280",
    "@types/webextension-polyfill": "^0.12.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^4.15.1",
    "happy-dom": "^20.11.1",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.11",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@fontsource/young-serif": "^5.3.0",
    "@wxt-dev/i18n": "^0.2.5",
    "@wxt-dev/storage": "^1.2.9",
    "sentinel-js": "^0.0.7"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run ft && pnpm run lint"
  },
  "pnpm": {
    "//": "Security overrides for vulnerable transitive dev dependencies. Each entry is pinned to the lowest patched version the advisory allows, scoped by major where the tree holds more than one line so unaffected copies keep their own resolution. Drop an entry once the parent package ships a fix of its own.",
    "overrides": {
      "adm-zip": "^0.6.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "esbuild@>=0.27.0 <0.28.0": "^0.28.1",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.18",
      "sharp": "^0.35.4",
      "shell-quote": "^1.10.0",
      "tmp": "^0.2.7",
      "uuid@8": "^11.1.1"
    }
  }
}
